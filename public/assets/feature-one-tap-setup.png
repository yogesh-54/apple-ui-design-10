<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 480" width="100%" height="100%">
  <defs>
    <linearGradient id="phoneBg" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#1c1c1e"/>
      <stop offset="100%" stop-color="#000000"/>
    </linearGradient>
    <linearGradient id="cardGrad" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#ffffff"/>
      <stop offset="100%" stop-color="#f2f2f7"/>
    </linearGradient>
  </defs>
  <!-- iPhone frame -->
  <rect x="40" y="20" width="320" height="440" rx="36" fill="url(#phoneBg)" stroke="#3a3a3c" stroke-width="6"/>
  <!-- Screen content -->
  <rect x="52" y="32" width="296" height="416" rx="28" fill="#121214"/>
  <!-- Dynamic Island -->
  <rect x="150" y="44" width="100" height="24" rx="12" fill="#000000"/>
  <!-- Background Home Screen App Icons hint -->
  <g opacity="0.3">
    <rect x="75" y="90" width="46" height="46" rx="10" fill="#30d158"/>
    <rect x="135" y="90" width="46" height="46" rx="10" fill="#0a84ff"/>
    <rect x="195" y="90" width="46" height="46" rx="10" fill="#ff9f0a"/>
    <rect x="255" y="90" width="46" height="46" rx="10" fill="#bf5af2"/>
    <rect x="75" y="150" width="46" height="46" rx="10" fill="#ff375f"/>
    <rect x="135" y="150" width="46" height="46" rx="10" fill="#64d2ff"/>
    <rect x="195" y="150" width="46" height="46" rx="10" fill="#ffd60a"/>
    <rect x="255" y="150" width="46" height="46" rx="10" fill="#5e5ce6"/>
  </g>
  <!-- Apple AirPods Pop-up Card -->
  <rect x="65" y="195" width="270" height="235" rx="28" fill="url(#cardGrad)" filter="drop-shadow(0 15px 30px rgba(0,0,0,0.5))"/>
  <!-- AirPods Case 3D Illustration inside Card -->
  <rect x="155" y="215" width="90" height="70" rx="26" fill="#ffffff" stroke="#e5e5ea" stroke-width="2"/>
  <line x1="155" y1="236" x2="245" y2="236" stroke="#d1d1d6" stroke-width="1.5"/>
  <circle cx="200" cy="254" r="3" fill="#34c759"/>
  <!-- Text in modal -->
  <text x="200" y="318" text-anchor="middle" font-family="-apple-system, Inter, sans-serif" font-weight="700" font-size="17" fill="#1d1d1f">AirPods Pro</text>
  <text x="200" y="338" text-anchor="middle" font-family="-apple-system, Inter, sans-serif" font-weight="400" font-size="12" fill="#86868b">Connect to John’s iPhone</text>
  <!-- Connect Button -->
  <rect x="95" y="360" width="210" height="44" rx="22" fill="#0071e3"/>
  <text x="200" y="387" text-anchor="middle" font-family="-apple-system, Inter, sans-serif" font-weight="600" font-size="15" fill="#ffffff">Connect</text>
</svg>
