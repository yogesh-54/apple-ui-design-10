<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 480" width="100%" height="100%">
  <rect width="400" height="480" fill="#ffffff" rx="28"/>
  <rect x="30" y="30" width="340" height="420" rx="20" fill="#fbfbfd" stroke="#e5e5ea" stroke-width="1.5"/>

  <!-- Accessibility Symbol Circle -->
  <circle cx="200" cy="180" r="70" fill="none" stroke="#0071e3" stroke-width="4"/>
  
  <!-- Apple Accessibility Figure -->
  <circle cx="200" cy="145" r="14" fill="#0071e3"/>
  <path d="M165 170h70 M200 170v35 M180 230l20-25 20 25" stroke="#0071e3" stroke-width="5" stroke-linecap="round" stroke-linejoin="round" fill="none"/>

  <!-- Features List Pill -->
  <g transform="translate(60, 275)">
    <rect width="280" height="44" rx="12" fill="#f2f2f7"/>
    <text x="20" y="27" font-family="-apple-system, Inter, sans-serif" font-weight="500" font-size="13" fill="#1d1d1f">Live Listen</text>
    <circle cx="255" cy="22" r="6" fill="#34c759"/>
  </g>

  <g transform="translate(60, 330)">
    <rect width="280" height="44" rx="12" fill="#f2f2f7"/>
    <text x="20" y="27" font-family="-apple-system, Inter, sans-serif" font-weight="500" font-size="13" fill="#1d1d1f">Conversation Boost</text>
    <text x="235" y="27" font-family="-apple-system, Inter, sans-serif" font-weight="500" font-size="12" fill="#0071e3">On</text>
  </g>

  <text x="200" y="420" text-anchor="middle" font-family="-apple-system, Inter, sans-serif" font-weight="600" font-size="16" fill="#1d1d1f">Hearing health for everyone</text>
</svg>
