<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 480" width="100%" height="100%">
  <defs>
    <linearGradient id="spaBg" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#ffffff"/>
      <stop offset="100%" stop-color="#f5f5f7"/>
    </linearGradient>
    <radialGradient id="meshGrad" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#0071e3" stop-opacity="0.3"/>
      <stop offset="100%" stop-color="#0071e3" stop-opacity="0"/>
    </radialGradient>
  </defs>
  <!-- iPhone frame -->
  <rect x="40" y="20" width="320" height="440" rx="36" fill="#f2f2f7" stroke="#d1d1d6" stroke-width="6"/>
  <rect x="52" y="32" width="296" height="416" rx="28" fill="url(#spaBg)"/>
  <!-- Dynamic Island -->
  <rect x="150" y="44" width="100" height="24" rx="12" fill="#000000"/>
  <!-- Spatial audio calibration animation -->
  <circle cx="200" cy="220" r="100" fill="url(#meshGrad)"/>
  <circle cx="200" cy="220" r="80" stroke="#0071e3" stroke-width="1.5" stroke-dasharray="4 4" fill="none" opacity="0.6"/>
  <circle cx="200" cy="220" r="50" stroke="#0071e3" stroke-width="2" fill="none"/>
  <!-- Head Silhouette Outline -->
  <path d="M175 250c-15-10-25-30-25-50 0-28 22-50 50-50s50 22 50 50c0 20-10 40-25 50v20h-50v-20z" fill="none" stroke="#1d1d1f" stroke-width="3"/>
  <path d="M140 200c0-15 5-25 15-30" stroke="#0071e3" stroke-width="3" stroke-linecap="round" fill="none"/>
  <path d="M260 200c0-15-5-25-15-30" stroke="#0071e3" stroke-width="3" stroke-linecap="round" fill="none"/>
  <!-- Text -->
  <text x="200" y="340" text-anchor="middle" font-family="-apple-system, Inter, sans-serif" font-weight="700" font-size="18" fill="#1d1d1f">Personalized Spatial Audio</text>
  <text x="200" y="365" text-anchor="middle" font-family="-apple-system, Inter, sans-serif" font-weight="400" font-size="12" fill="#86868b">Uses TrueDepth camera to calibrate sound</text>
  <rect x="120" y="390" width="160" height="36" rx="18" fill="#0071e3"/>
  <text x="200" y="413" text-anchor="middle" font-family="-apple-system, Inter, sans-serif" font-weight="600" font-size="13" fill="#ffffff">Turn On</text>
</svg>
